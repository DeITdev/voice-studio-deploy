# Port to expose the Voicebox Backend API on the DGX Spark VM
BACKEND_PORT=17493

# PyTorch build variant (`cuda` for NVIDIA DGX Spark, `rocm` for AMD, `cpu` for CPU)
PYTORCH_VARIANT=cuda

# CUDA wheel index (`cu128` supports ARM64 Grace Blackwell GB10 on DGX Spark as well as x86_64)
CUDA_VERSION=cu128

# Host directory on the DGX VM where TTS, ASR (Whisper), and LLM models will be downloaded
MODELS_HOST_DIR=./models

# Host directory on the DGX VM for database, voice profiles, captures, and generated audio
DATA_HOST_DIR=./data

# Optional: if connecting directly from browser instead of the Web VM's Nginx proxy,
# add the Web UI VM origin here (e.g., http://192.168.1.50:17600)
VOICEBOX_CORS_ORIGINS=

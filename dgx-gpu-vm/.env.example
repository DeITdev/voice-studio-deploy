# Port to expose the VoiceStudio Backend API on the DGX Spark VM (default: 3900)
BACKEND_PORT=3900

# Administrator API key (REQUIRED by VoiceStudio in server/Docker mode).
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# You will enter this same key in the browser UI on first login.
OMNIVOICE_API_KEY=change-me-to-a-long-random-secret-key

# Host directory on the DGX VM for VoiceStudio database, voice profiles, projects, and outputs
DATA_HOST_DIR=./omnivoice_data

# Host directory on the DGX VM where Hugging Face TTS/ASR/translation models are downloaded
MODELS_HOST_DIR=./models

# Optional Hugging Face access token (for gated models)
HF_TOKEN=

# Optional comma-separated list of allowed browser origins if connecting cross-origin
# (e.g., http://192.168.1.50:17600)
OMNIVOICE_ALLOWED_ORIGINS=

# Allowed Host header values (* allows any hostname when behind the Web VM Nginx proxy)
OMNIVOICE_ALLOWED_HOSTS=*

# Disable product analytics (1 = disabled)
OMNIVOICE_ANALYTICS_DISABLED=1

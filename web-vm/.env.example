# IP/hostname and port (default 3900) of your NVIDIA DGX Spark GPU VM running the VoiceStudio backend
DGX_BACKEND_URL=http://192.168.1.100:3900

# Host port to expose the VoiceStudio Web UI on this VM
WEB_PORT=17600

# API base injected as window.__OMNIVOICE_API_BASE__ (`/` + `api` proxies through Nginx to DGX_BACKEND_URL)
FRONTEND_API_BASE=/api

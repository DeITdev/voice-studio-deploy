# IP/hostname and port of your NVIDIA DGX Spark GPU VM running the Voicebox backend
DGX_BACKEND_URL=http://192.168.1.100:17493

# Host port to expose the Voice Studio Web UI on this VM
WEB_PORT=17600

# Default API base path used by the browser (`/` + `api` proxies through Nginx to DGX_BACKEND_URL)
FRONTEND_SERVER_URL=/api
